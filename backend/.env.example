# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.

# --- LLM provider ------------------------------------------------------------
# Mistral (default) — get a free key at https://console.mistral.ai/api-keys
# LLM_API_KEY=your-mistral-api-key-here
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# Other good Mistral models: mistral-large-latest (higher quality, slower/pricier),
# open-mistral-nemo (fast + cheap)

# --- Alternatives (comment out Mistral above, uncomment one block below) ----
# OpenAI:
# LLM_API_KEY=sk-your-openai-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Ollama (free, fully local, no API key):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- Database ------------------------------------------------------------------
DATABASE_URL=sqlite:///./course_generator.db

# --- Auth --------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- CORS ----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
